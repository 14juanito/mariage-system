# Copiez ce fichier en .env (jamais commité) et remplissez les valeurs réelles.
# Ne mettez JAMAIS de vrai secret dans ce fichier .env.example.

# --- Base de données MySQL ---
# Format : mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://mariage_app:changeme@localhost:3306/mariage_system"

# --- Sécurité des sessions ---
# Chaîne aléatoire longue (>= 32 caractères), utilisée pour signer les cookies de session.
# Générer avec : openssl rand -base64 48
SESSION_SECRET="changeme_generate_a_long_random_secret"

# --- URL publique de l'application (utilisée pour générer les liens d'invitation et les QR codes) ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Environnement ---
NODE_ENV="development"
